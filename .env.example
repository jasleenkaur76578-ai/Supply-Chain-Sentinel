# Supply Chain Sentinel — Environment Configuration Template
# Copy this file to .env and configure for your environment

# Platform Environment
ENVIRONMENT=development
LOG_LEVEL=INFO

# Security & Cryptography
SECRET_KEY=sentinel_super_secret_enterprise_jwt_key_replace_in_prod_32bytes_minimum!
ACCESS_TOKEN_EXPIRE_MINUTES=480
ALGORITHM=HS256

# Database Configuration
# For standalone local run: sqlite:///./sentinel.db
# For production PostgreSQL: postgresql://sentinel:sentinel_secure_pass@localhost:5432/sentinel_db
DATABASE_URL=sqlite:///./sentinel.db

# Cache & Redis (Optional for local, used for background tasks & intelligence cache)
REDIS_URL=redis://localhost:6379/0

# Vulnerability Intelligence API Endpoints
OSV_API_URL=https://api.osv.dev/v1
CISA_KEV_FEED_URL=https://www.cisa.gov/sites/default/files/feeds/known_exploited_vulnerabilities.json
EPSS_API_URL=https://api.first.org/data/v1/epss
NVD_API_URL=https://services.nvd.nist.gov/rest/json/cves/2.0
NVD_API_KEY=

# AI Security Analyst Configuration
# Options: gemini, openai, anthropic, mock
AI_PROVIDER=gemini
GEMINI_API_KEY=
OPENAI_API_KEY=
ANTHROPIC_API_KEY=

# CORS Settings
CORS_ORIGINS=["http://localhost:5173", "http://127.0.0.1:5173", "http://localhost:3000"]
